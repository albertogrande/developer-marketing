# build output
dist/
# astro cache
.astro/
# deps
node_modules/
# newsletter: the subscriber list, the send logs and the dry-run outbox. Real
# addresses must never end up in git.
newsletter/data/
/data/
*.eml
.env
# podcast transcripts fetched by scripts/podcast-transcripts.mjs. Cached for
# verification only and deliberately never committed: a transcript is the
# publisher's copyrighted work, and this repo's own CC BY 4.0 licence cannot be
# applied to a third party's words. Quote briefly with attribution instead.
.cache/
# Reader-feedback working files, materialised per Weekly run from GitHub
# issues and consumed in-run — third-party text, never committed.
editorial/FEEDBACK-INBOX.md
editorial/FEEDBACK-REPLIES.md
# os / editor
.DS_Store
*.log

# Jobs sweep scratch — the scraper's checkpoint file; merge consumes and deletes it.
signals/jobs/incoming.json

# Research working directory for one-off dossiers (scripts/make-ebook.mjs input).
# Same reasoning as .cache/ above: these books reproduce third parties' posts in
# full so they can be read offline, and this repo's CC BY 4.0 licence cannot be
# applied to somebody else's words. The generator is committed; its input and
# output are not.
research/
