{
  "name": "developer-marketing",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-refs.mjs && astro build && pagefind --site dist && node scripts/check-agent-surface.mjs",
    "preview": "astro preview",
    "check": "node scripts/check-refs.mjs && node scripts/check-editorial.mjs && node scripts/check-sources.mjs --changed",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "evals": "node evals/run.mjs",
    "podcast:transcripts": "node scripts/podcast-transcripts.mjs",
    "scout:sweep": "node scripts/scout-sweep.mjs",
    "scout:enrich": "node scripts/scout-enrich.mjs",
    "scout:query": "node scripts/scout-query.mjs",
    "newsletter:serve": "node newsletter/server.mjs",
    "newsletter:doctor": "node newsletter/doctor.mjs",
    "newsletter:send": "node newsletter/send.mjs",
    "newsletter:export": "node newsletter/export.mjs",
    "newsletter:preview": "node newsletter/send.mjs --dry-run --out newsletter/data/preview.html",
    "astro": "astro",
    "jobs:merge": "node scripts/jobs-merge.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "astro": "^5.2.0",
    "marked": "^18.0.7",
    "sass": "^1.83.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "pagefind": "^1.3.0"
  },
  "optionalDependencies": {
    "pg": "^8.22.0"
  }
}
