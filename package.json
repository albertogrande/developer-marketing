{
  "name": "developer-marketing",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-refs.mjs && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "node scripts/check-refs.mjs && node scripts/check-sources.mjs --changed",
    "test": "node --test newsletter/test/*.test.mjs",
    "newsletter:serve": "node newsletter/server.mjs",
    "newsletter:doctor": "node newsletter/doctor.mjs",
    "newsletter:send": "node newsletter/send.mjs",
    "newsletter:preview": "node newsletter/send.mjs --dry-run --out newsletter/data/preview.html",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "astro": "^5.2.0",
    "sass": "^1.83.0"
  },
  "devDependencies": {
    "pagefind": "^1.3.0",
    "yaml": "^2.9.0"
  }
}
