---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveNotice from '../../components/ArchiveNotice.astro';
import TagList from '../../components/TagList.astro';
import { withBase, absUrl, isoDate } from '../../lib/site';
import { getDivesSorted } from '../../lib/content';
import { collectionPageNode } from '../../lib/jsonld';

const dives = await getDivesSorted();
---
<BaseLayout
  title="Deep dives"
  description="Long-form, researched deep dives on developer marketing — the plays, metrics, and decisions worth getting right. Each one sourced."
  jsonLd={[
    collectionPageNode({
      name: 'Deep Dives',
      description:
        'Long-form, researched deep dives on developer marketing — the plays, metrics, and decisions worth getting right. Each one sourced.',
      url: absUrl('/deep-dives'),
      items: dives.map((v) => ({ name: v.data.title, url: absUrl(`/deep-dives/${v.id}`) })),
    }),
  ]}
>
  <ArchiveNotice now="depth now ships as a long special issue" />
  <div class="page-head">
    <div class="kicker"><span class="prompt" aria-hidden="true">&gt;</span> deep dives</div>
    <h1 class="page-title">Deep dives</h1>
  </div>

  {dives.length > 0 ? (
    <ul class="ar-list">
      {dives.map((d) => (
        <li class="ar-row">
          <span class="ar-date">{isoDate(d.data.date)}</span>
          <div class="ar-main">
            <div class="ar-head">
              <span class="kind">deep dive</span>
              <a href={withBase(`/deep-dives/${d.id}`)} class="ar-title">{d.data.title}</a>
            </div>
            <span class="ar-meta">{d.data.summary}</span>
            <TagList tags={d.data.tags} style="margin-top:8px" />
          </div>
        </li>
      ))}
    </ul>
  ) : (
    <p class="dek">The first dive is in the works. Check back shortly.</p>
  )}
</BaseLayout>
