---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import { render } from 'astro:content';
import { withBase, absUrl, isoDate } from '../../lib/site';
import { getExamplesSorted, getGuideSorted } from '../../lib/content';
import { collectionPageNode } from '../../lib/jsonld';

// The swipe file — real, sourced dev-marketing artifacts, newest first. Each
// card carries the "why it works" note, the guide section it demonstrates, and
// a link to the real thing. Machines read the same set at /examples.json.

const [examples, guide] = await Promise.all([getExamplesSorted(), getGuideSorted()]);
const sectionTitle = new Map(guide.map((g) => [g.id, g.data.title]));

const cards = await Promise.all(
  examples.map(async (e) => ({ e, Content: (await render(e)).Content }))
);
---
<BaseLayout
  title="Examples"
  description="A swipe file of real, sourced developer-marketing artifacts — pricing pages, API references, launches — each with what makes it work and a link to the real thing."
  jsonLd={[
    collectionPageNode({
      name: 'Examples',
      description:
        'A swipe file of real, sourced developer-marketing artifacts — pricing pages, API references, launches — each with what makes it work and a link to the real thing.',
      url: absUrl('/examples'),
      items: examples.map((e) => ({
        name: `${e.data.company}: ${e.data.title}`,
        url: `${absUrl('/examples')}#${e.id}`,
      })),
    }),
  ]}
>
  <div class="page-head">
    <div class="kicker"><span class="prompt" aria-hidden="true">&gt;</span> examples</div>
    <h1 class="page-title">Examples</h1>
  </div>

  {cards.length > 0 ? (
    <div class="ex-grid" data-pagefind-body>
      {cards.map(({ e, Content }) => (
        <article class="ex" id={e.id} data-date={isoDate(e.data.date)}>
          <div class="ex-top">
            <span class="ex-co">{e.data.company}</span>
            <span class="ex-chip ex-artifact" data-pagefind-filter="artifact">{e.data.artifact}</span>
            {e.data.channel.map((c) => <span class="ex-chip dim" data-pagefind-filter="channel">{c}</span>)}
          </div>
          <h2 class="ex-h"><a href={`#${e.id}`}>{e.data.title}</a></h2>
          <div class="ex-why"><Content /></div>
          <div class="ex-meta">
            {sectionTitle.has(e.data.demonstrates) && (
              <a class="ex-demo" href={withBase(`/guide/${e.data.demonstrates}`)}>
                <span class="amber" aria-hidden="true">→</span> {sectionTitle.get(e.data.demonstrates)}
              </a>
            )}
            <TagList tags={e.data.tags} />
            <span class="ex-src">
              <a href={e.data.source.url} rel="noopener">{e.data.source.label}</a>
              {e.data.sources.map((s) => (
                <Fragment>
                  <span class="dim"> · </span>
                  <a href={s.url} rel="noopener">{s.label}</a>
                </Fragment>
              ))}
            </span>
            <span class="dim ex-date">{isoDate(e.data.date)}</span>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <p class="dek">The first examples are being collected. Check back shortly.</p>
  )}
</BaseLayout>

<style>
  .ex-grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .ex {
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    padding: 1.1rem 1.2rem 1rem;
    background: var(--panel, transparent);
  }
  .ex-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
  }
  .ex-co {
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .ex-chip {
    font-size: var(--fs-meta);
    font-family: var(--font-mono);
    padding: 0.08rem 0.4rem;
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    line-height: var(--lh-normal);
  }
  .ex-artifact {
    color: var(--accent);
    border-color: currentColor;
  }
  .ex-h {
    font-size: var(--fs-lead);
    margin: 0 0 0.4rem;
    line-height: var(--lh-snug);
  }
  .ex-h a { text-decoration: none; }
  .ex-h a:hover { text-decoration: underline; }
  .ex-why {
    font-size: var(--fs-dek);
    line-height: var(--lh-prose);
  }
  .ex-why :global(p) { margin: 0.35rem 0 0; }
  .ex-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.85rem;
    font-size: var(--fs-ui);
  }
  .ex-demo {
    font-weight: 500;
    text-decoration: none;
  }
  .ex-demo:hover { text-decoration: underline; }
  .ex-src { margin-left: auto; }
  .ex-date { font-family: var(--font-mono); }
</style>
