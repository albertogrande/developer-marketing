---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveNotice from '../../components/ArchiveNotice.astro';
import TagList from '../../components/TagList.astro';
import { withBase, absUrl, isoDate } from '../../lib/site';
import { getArticlesSorted, DESK_LABELS } from '../../lib/content';
import { collectionPageNode } from '../../lib/jsonld';

const articles = await getArticlesSorted();
const desks = (['news', 'money', 'campaigns', 'research', 'technology'] as const)
  .map((d) => ({ key: d, label: DESK_LABELS[d], n: articles.filter((a) => a.data.desk === d).length }))
  .filter((d) => d.n > 0);
---
<BaseLayout
  title="The Newsroom"
  description="Dated articles on the news, money, campaigns, research, and technology of the developer-tools industry — written by specialized desks, at most one a day, only when the story earns it."
  jsonLd={[
    collectionPageNode({
      name: 'The Newsroom',
      description:
        'Dated articles on the news, money, campaigns, research, and technology of the developer-tools industry — written by specialized desks, at most one a day, only when the story earns it.',
      url: absUrl('/articles'),
      items: articles.map((a) => ({ name: a.data.title, url: absUrl(`/articles/${a.id}`) })),
    }),
  ]}
>
  <ArchiveNotice now="analysis now ships in the weekly issue" />
  <div class="page-head">
    <div class="kicker"><span class="prompt" aria-hidden="true">&gt;</span> newsroom</div>
    <h1 class="page-title">The Newsroom</h1>
    <p class="dek">
      The news, money, campaigns, research, and technology of the devtools
      industry — one article a day at most, and only when the story earns it
      (see the <a href={withBase('/about')}>masthead</a>). The running
      reference lives in the <a href={withBase('/guide')}>guide</a>; the
      weekly synthesis in <a href={withBase('/issues')}>The Week</a>.
    </p>
  </div>

  {desks.length > 1 && (
    <div class="fd-beats" role="group" aria-label="Filter by desk">
      <button class="fd-beat is-on" data-desk="all" type="button">all <span class="ar-count">{articles.length}</span></button>
      {desks.map((d) => (
        <button class="fd-beat" data-desk={d.key} type="button">{d.label.toLowerCase()} <span class="ar-count">{d.n}</span></button>
      ))}
    </div>
  )}

  {articles.length > 0 ? (
    <ul class="ar-list" id="article-list">
      {articles.map((a) => (
        <li class="ar-row" data-desk={a.data.desk}>
          <span class="ar-date">{isoDate(a.data.date)}</span>
          <div class="ar-main">
            <div class="ar-head">
              <span class="kind">{DESK_LABELS[a.data.desk]}</span>
              <a href={withBase(`/articles/${a.id}`)} class="ar-title">{a.data.title}</a>
            </div>
            <span class="ar-meta">{a.data.byline} · {a.data.summary}</span>
            <TagList tags={a.data.tags} style="margin-top:8px" />
          </div>
        </li>
      ))}
    </ul>
  ) : (
    <p class="dek">The first edition is in the works. Check back shortly.</p>
  )}

  <script is:inline>
    (function () {
      var chips = [].slice.call(document.querySelectorAll('.fd-beat[data-desk]'));
      var rows = [].slice.call(document.querySelectorAll('#article-list [data-desk]'));
      if (!chips.length) return;
      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          var desk = chip.getAttribute('data-desk');
          chips.forEach(function (c) { c.classList.toggle('is-on', c === chip); });
          rows.forEach(function (r) {
            r.style.display = desk === 'all' || r.getAttribute('data-desk') === desk ? '' : 'none';
          });
        });
      });
    })();
  </script>
</BaseLayout>
