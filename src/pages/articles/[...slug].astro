---
import ReadingLayout from '../../layouts/ReadingLayout.astro';
import ArticleFoot from '../../components/ArticleFoot.astro';
import TagList from '../../components/TagList.astro';
import { withBase, fmtLong, isoDate } from '../../lib/site';
import { getArticlesSorted, DESK_LABELS } from '../../lib/content';
import { AUTHORS } from '../../lib/authors';
import { newsArticleNode } from '../../lib/jsonld';
import { render } from 'astro:content';

export async function getStaticPaths() {
  // Sorted newest-first: prev = the newer piece, next = the older one, plus
  // up to three more articles from the same desk for the byline block.
  const articles = await getArticlesSorted();
  return articles.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      newer: i > 0 ? articles[i - 1] : null,
      older: i < articles.length - 1 ? articles[i + 1] : null,
      fromDesk: articles
        .filter((a) => a.data.desk === entry.data.desk && a.id !== entry.id)
        .slice(0, 3),
    },
  }));
}

const { entry, newer, older, fromDesk } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const author = AUTHORS[d.desk];
---
<ReadingLayout
  title={d.title}
  description={d.summary}
  deskLabel={DESK_LABELS[d.desk]}
  stamp={`${d.byline} · ${fmtLong(d.date)}`}
  published={d.date}
  updated={d.updated}
  jsonLd={[newsArticleNode(entry)]}
>
  <div class="entry-lead" slot="lead">
    <span class="kind">{DESK_LABELS[d.desk].toLowerCase()}</span>
    <TagList tags={d.tags} />
  </div>

  {d.dek && <p class="dek">{d.dek}</p>}

  <Content />

  <Fragment slot="foot">
    {author && (
      <div class="byline-card">
        <span class="byline-name">{author.name}</span>
        <span class="byline-desk">{author.title}</span>
        <p class="byline-line">{author.line}</p>
      </div>
    )}

    {fromDesk.length > 0 && (
      <div class="hub" style="margin-top:26px">
        <div class="hub-sec">
          <p class="hub-h">More from {DESK_LABELS[d.desk]}</p>
          <ul class="hub-list">
            {fromDesk.map((a) => (
              <li class="hub-item">
                <a href={withBase(`/articles/${a.id}`)}>{a.data.title}</a>
                <span class="hub-m">{isoDate(a.data.date)}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}

    <ArticleFoot
      updated={d.updated}
      related={d.related}
      sources={d.sources}
      backHref={older ? `/articles/${older.id}` : '/articles'}
      backLabel={older ? `earlier: ${older.data.title}` : 'the newsroom'}
      forwardHref={newer ? `/articles/${newer.id}` : '/guide'}
      forwardLabel={newer ? `later: ${newer.data.title}` : 'the guide'}
    />
  </Fragment>
</ReadingLayout>
