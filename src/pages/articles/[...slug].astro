---
import { getCollection, render } from 'astro:content';
import ReadingLayout from '../../layouts/ReadingLayout.astro';
import ArticleFoot from '../../components/ArticleFoot.astro';
import TagList from '../../components/TagList.astro';
import { fmtLong } from '../../lib/site';
import { DESK_LABELS } from '../../lib/content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<ReadingLayout
  title={d.title}
  description={d.summary}
  deskLabel={DESK_LABELS[d.desk]}
  stamp={`${d.byline} · ${fmtLong(d.date)}`}
  published={d.date}
  updated={d.updated}
>
  <div class="entry-lead" slot="lead">
    <span class="kind">{DESK_LABELS[d.desk].toLowerCase()}</span>
    <TagList tags={d.tags} />
  </div>

  {d.dek && <p class="dek">{d.dek}</p>}

  <Content />

  <ArticleFoot
    slot="foot"
    updated={d.updated}
    related={d.related}
    sources={d.sources}
    backHref="/articles"
    backLabel="the newsroom"
    forwardHref="/guide"
    forwardLabel="the guide"
  />
</ReadingLayout>
