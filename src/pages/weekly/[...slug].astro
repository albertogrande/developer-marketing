---
import { getCollection, render } from 'astro:content';
import ReadingLayout from '../../layouts/ReadingLayout.astro';
import ArticleFoot from '../../components/ArticleFoot.astro';
import TagList from '../../components/TagList.astro';
import { absUrl, fmtLong } from '../../lib/site';
import { entryByDateDesc } from '../../lib/content';
import { articleNode } from '../../lib/jsonld';

export async function getStaticPaths() {
  // Sorted newest-first: issue navigation walks the archive — earlier issue
  // back, later issue forward.
  const weekly = (await getCollection('weekly')).sort(entryByDateDesc);
  return weekly.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      later: i > 0 ? weekly[i - 1] : null,
      earlier: i < weekly.length - 1 ? weekly[i + 1] : null,
    },
  }));
}

const { entry, later, earlier } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<ReadingLayout
  title={d.title}
  description={d.summary}
  deskLabel="The Week"
  stamp={`${d.week} · ${fmtLong(d.date)}`}
  published={d.published}
  updated={d.updated}
  jsonLd={[
    articleNode({
      schemaType: 'Article',
      title: d.title,
      description: d.summary,
      url: absUrl(`/weekly/${entry.id}`),
      published: d.published,
      updated: d.updated,
      section: 'The Week',
      tags: d.tags,
      sources: d.sources,
    }),
  ]}
>
  <div class="entry-lead" slot="lead">
    <span class="kind">the week</span>
    <TagList tags={d.tags} />
  </div>

  <Content />

  <ArticleFoot
    slot="foot"
    updated={d.updated}
    related={d.related}
    sources={d.sources}
    backHref={earlier ? `/weekly/${earlier.id}` : '/weekly'}
    backLabel={earlier ? `${earlier.data.week}` : 'all issues'}
    forwardHref={later ? `/weekly/${later.id}` : '/guide'}
    forwardLabel={later ? `${later.data.week}` : 'the guide'}
  />
</ReadingLayout>
