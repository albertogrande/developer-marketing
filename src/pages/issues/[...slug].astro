---
import { getCollection, render } from 'astro:content';
import ReadingLayout from '../../layouts/ReadingLayout.astro';
import ArticleFoot from '../../components/ArticleFoot.astro';
import TagList from '../../components/TagList.astro';
import { absUrl, fmtWeekRange, withBase, isoDate } from '../../lib/site';
import { entryByDateDesc, getSignalsByWeek, getThreadGraph, SIGNAL_KIND_LABELS } from '../../lib/content';
import { articleNode } from '../../lib/jsonld';

export async function getStaticPaths() {
  // Sorted newest-first: issue navigation walks the archive — earlier issue
  // back, later issue forward.
  const weekly = (await getCollection('issues')).sort(entryByDateDesc);
  return weekly.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      later: i > 0 ? weekly[i - 1] : null,
      earlier: i < weekly.length - 1 ? weekly[i + 1] : null,
    },
  }));
}

const { entry, later, earlier } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// "The week in links" — derived, not written. The signals filed in this issue's
// ISO week already carry company, two sentences and a source, so the roundup
// costs one lookup instead of a second pass by the editor. The digest above is
// the opinion; this is the record of what happened. Empty for any week that
// closed before the signals existed, and the section simply doesn't render.
//
// Classified by kind, in a fixed reading order — patterns first (the week's
// intelligence), then the launches and releases, then the rest. Within a
// group, newest first (the map's order is already date-descending).
const briefsThisWeek = (await getSignalsByWeek()).get(d.week) ?? [];
const KIND_ORDER: (typeof briefsThisWeek)[number]['data']['kind'][] = [
  'signal', 'launch', 'release', 'news', 'funding', 'campaign', 'discussion', 'podcast',
];
const linkGroups = KIND_ORDER
  .map((kind) => ({ kind, label: SIGNAL_KIND_LABELS[kind], items: briefsThisWeek.filter((b) => b.data.kind === kind) }))
  .filter((g) => g.items.length > 0);

// The running threads this issue advanced — an issue is a week's worth of one
// or two arguments, and this is where a reader picks the argument back up.
const { threadsByMember } = await getThreadGraph();
const threads = threadsByMember.get(`issues:${entry.id}`) ?? [];
---
<ReadingLayout
  title={d.title}
  description={d.summary}
  deskLabel="The Beat"
  stamp={`${d.week} · ${fmtWeekRange(d.date)}`}
  published={d.published}
  updated={d.updated}
  jsonLd={[
    articleNode({
      schemaType: 'Article',
      title: d.title,
      description: d.summary,
      url: absUrl(`/issues/${entry.id}`),
      published: d.published,
      updated: d.updated,
      section: 'The Beat',
      tags: d.tags,
      sources: d.sources,
    }),
  ]}
>
  <div class="entry-lead" slot="lead">
    <span class="kind">the week</span>
    <TagList tags={d.tags} />
  </div>

  {threads.length > 0 && (
    <p class="wil-threads">
      <span class="dim">advances</span>
      {threads.map((t, i) => (
        <Fragment>
          {i > 0 && <span class="dim"> · </span>}
          <a href={withBase(`/threads/${t.id}`)}>{t.data.title}</a>
        </Fragment>
      ))}
    </p>
  )}

  <Content />

  {briefsThisWeek.length > 0 && (
    <section class="wil">
      <h2 class="wil-h">The week in links</h2>
      <p class="wil-dek">
        Everything Signals filed in {d.week} — {briefsThisWeek.length} item{briefsThisWeek.length === 1 ? '' : 's'},
        by section. The full stream lives at <a href={withBase('/signals')}>Signals</a>.
      </p>
      {linkGroups.map((g) => (
        <section aria-label={g.label}>
          <h3 class="wil-kind"><span class="amber" aria-hidden="true">##</span> {g.label}{g.items.length > 1 ? ` · ${g.items.length}` : ''}</h3>
          <ul class="wil-list">
            {g.items.map((b) => (
              <li class="wil-row">
                <span class="wil-date">{isoDate(b.data.date).slice(5)}</span>
                <div class="wil-main">
                  <a href={withBase(`/signals#${b.id}`)} class="wil-t">
                    <b>{b.data.company}</b> — {b.data.title}
                  </a>
                  <p class="wil-sum">{b.data.summary}</p>
                  <a class="wil-src" href={b.data.source.url} rel="noopener">{b.data.source.label}</a>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </section>
  )}

  <ArticleFoot
    slot="foot"
    updated={d.updated}
    related={d.related}
    sources={d.sources}
    backHref={earlier ? `/issues/${earlier.id}` : '/issues'}
    backLabel={earlier ? `${earlier.data.week}` : 'all issues'}
    forwardHref={later ? `/issues/${later.id}` : '/guide'}
    forwardLabel={later ? `${later.data.week}` : 'the guide'}
  />
</ReadingLayout>

<style>
  .wil-threads {
    font-size: 0.85rem;
    margin: 0 0 1.5rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--rule);
  }
  .wil-threads .dim { margin-right: 0.3rem; }
  .wil {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .wil-h {
    font-size: 1.15rem;
    margin: 0 0 0.3rem;
  }
  .wil-dek {
    font-size: 0.88rem;
    opacity: 0.75;
    margin: 0 0 1rem;
  }
  .wil-kind {
    font-family: var(--mono, monospace);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    margin: 1.4rem 0 0.2rem;
  }
  .wil-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .wil-row {
    display: flex;
    gap: 0.75rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--rule);
  }
  .wil-date {
    font-family: var(--mono, monospace);
    font-size: 0.78rem;
    opacity: 0.6;
    padding-top: 0.15rem;
    flex: 0 0 2.6rem;
  }
  .wil-main { min-width: 0; }
  .wil-t {
    text-decoration: none;
    line-height: 1.4;
  }
  .wil-t:hover { text-decoration: underline; }
  .wil-chip {
    font-size: 0.68rem;
    font-family: var(--mono, monospace);
    padding: 0.05rem 0.35rem;
    margin-left: 0.4rem;
    border: 1px solid currentColor;
    border-radius: 4px;
    color: var(--amber, #d08b1e);
    white-space: nowrap;
  }
  .wil-sum {
    font-size: 0.88rem;
    line-height: 1.55;
    margin: 0.3rem 0 0.25rem;
    opacity: 0.85;
  }
  .wil-src {
    font-size: 0.78rem;
    opacity: 0.7;
  }
</style>
