---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import NewsletterCta from '../../components/NewsletterCta.astro';
import { withBase, absUrl } from '../../lib/site';
import { getIssuesSorted } from '../../lib/content';
import { collectionPageNode } from '../../lib/jsonld';

const weekly = await getIssuesSorted();
---
<BaseLayout
  title="The Week"
  description="A short weekly digest of what changed in developer marketing — the one read to stay current. Newest first, each week sourced."
  jsonLd={[
    collectionPageNode({
      name: 'The Week',
      description:
        'A short weekly digest of what changed in developer marketing — the one read to stay current. Newest first, each week sourced.',
      url: absUrl('/issues'),
      items: weekly.map((w) => ({ name: w.data.title, url: absUrl(`/issues/${w.id}`) })),
    }),
  ]}
>
  <div class="page-head">
    <div class="kicker"><span class="prompt" aria-hidden="true">&gt;</span> issues</div>
    <h1 class="page-title">The Week</h1>
    <p class="dek">
      One short read a week on what actually moved in developer marketing — and
      what to do about it. The running reference lives in the
      <a href={withBase('/guide')}>guide</a>; this is the pulse. Earlier dated
      posts live in the <a href={withBase('/radar')}>radar archive</a>.
    </p>
  </div>

  {weekly.length > 0 ? (
    <ul class="ar-list">
      {weekly.map((w) => (
        <li class="ar-row">
          <span class="ar-date">{w.data.week}</span>
          <div class="ar-main">
            <div class="ar-head">
              <span class="kind">the week</span>
              <a href={withBase(`/issues/${w.id}`)} class="ar-title">{w.data.title}</a>
            </div>
            <span class="ar-meta">{w.data.summary}</span>
            <TagList tags={w.data.tags} style="margin-top:8px" />
          </div>
        </li>
      ))}
    </ul>
  ) : (
    <p class="dek">The first issue is in the works. Check back shortly.</p>
  )}

  <NewsletterCta
    variant="inline"
    source="/issues"
    heading="Have it delivered"
    blurb="The same digest, in your inbox on Monday mornings. Self-hosted list, no tracking, one-click unsubscribe."
  />
</BaseLayout>
