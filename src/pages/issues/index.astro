---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import NewsletterCta from '../../components/NewsletterCta.astro';
import { withBase, absUrl, fmtWeekRange } from '../../lib/site';
import { getIssuesSorted } from '../../lib/content';
import { collectionPageNode } from '../../lib/jsonld';

const weekly = await getIssuesSorted();
---
<!-- The page title is "Issues", not "The Beat": Head.astro treats a title equal
     to SITE_TITLE as the home page and swaps in the full masthead line, so
     naming this page after the publication would give it the home page's
     <title>. The h1 and the JSON-LD name still carry the publication name. -->
<BaseLayout
  title="Issues"
  description="A short weekly digest of what changed in developer marketing — the one read to stay current. Newest first, each week sourced."
  jsonLd={[
    collectionPageNode({
      name: 'The Beat',
      description:
        'A short weekly digest of what changed in developer marketing — the one read to stay current. Newest first, each week sourced.',
      url: absUrl('/issues'),
      items: weekly.map((w) => ({ name: w.data.title, url: absUrl(`/issues/${w.id}`) })),
    }),
  ]}
>
  <div class="page-head">
    <div class="kicker"><span class="prompt" aria-hidden="true">&gt;</span> weekly</div>
    <h1 class="page-title">The Beat</h1>
  </div>

  {weekly.length > 0 ? (
    <ul class="ar-list">
      {weekly.map((w) => (
        <li class="ar-row">
          <span class="ar-date">{w.data.week}</span>
          <div class="ar-main">
            <div class="ar-head">
              <span class="kind">the week</span>
              <a href={withBase(`/issues/${w.id}`)} class="ar-title">{w.data.title}</a>
            </div>
            <span class="ar-meta"><span class="dim">{fmtWeekRange(w.data.date, 'med')}</span> · {w.data.summary}</span>
            <TagList tags={w.data.tags} style="margin-top:8px" />
          </div>
        </li>
      ))}
    </ul>
  ) : (
    <p class="dek">The first issue is in the works. Check back shortly.</p>
  )}

  <NewsletterCta
    variant="inline"
    source="/issues"
    heading="Have it delivered"
    blurb="The same digest, in your inbox on Monday mornings. Self-hosted list, no tracking, one-click unsubscribe."
  />
</BaseLayout>
