---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase, isoDate } from '../../lib/site';
import { getGuideSorted, getGuideGraph } from '../../lib/content';

// The handbook home. Each section shows what the site knows about the topic
// — practices, evidence, coverage — so a reader (and the editor) can see at
// a glance which topics are alive and which are thin.
const [guide, graph] = await Promise.all([getGuideSorted(), getGuideGraph()]);

const countsFor = (id: string) => {
  const parts: string[] = [];
  const p = graph.practicesBySection.get(id)?.length ?? 0;
  const e = graph.examplesBySection.get(id)?.length ?? 0;
  const s = graph.skillsBySection.get(id)?.length ?? 0;
  const c = graph.coverageBySection.get(id)?.length ?? 0;
  if (p) parts.push(`${p} practice${p > 1 ? 's' : ''}`);
  if (e) parts.push(`${e} example${e > 1 ? 's' : ''}`);
  if (s) parts.push(`${s} skill${s > 1 ? 's' : ''}`);
  if (c) parts.push(`${c} mention${c > 1 ? 's' : ''}`);
  return parts;
};
---
<BaseLayout
  title="Guide"
  description="A practitioner's field guide to developer marketing: positioning, docs, DevRel, developer experience, content, distribution, launches, and measurement."
>
  <div class="page-head">
    <div class="kicker"><span class="prompt" aria-hidden="true">&gt;</span> guide</div>
    <h1 class="page-title">The field guide</h1>
    <p class="dek">
      A practitioner's reference to marketing to developers — nine sections,
      each a topic hub gathering the evergreen state of the art, the
      <a href={withBase('/practices')}>practices</a> that implement it, the
      <a href={withBase('/examples')}>evidence</a> behind it, the
      <a href={withBase('/skills')}>skills</a> that automate it, and the coverage
      that keeps it honest. Each carries the date it was last checked.
    </p>
  </div>

  <ul class="fm-list">
    {guide.map((g) => {
      const counts = countsFor(g.id);
      return (
        <li class="fm-row">
          <span class="fm-ln">{String(g.data.order).padStart(2, '0')}</span>
          <div class="fm-rowmain">
            <div class="fm-row-head">
              <a href={withBase(`/guide/${g.id}`)} class="fm-row-t">{g.data.title}</a>
              <span class="stamp-updated">upd {isoDate(g.data.updated)}</span>
            </div>
            <p class="fm-row-dek">{g.data.summary}</p>
            {counts.length > 0 && (
              <div class="fm-row-m">
                {counts.map((c, i) => (
                  <Fragment>{i > 0 && <span class="dim">·</span>}<span>{c}</span></Fragment>
                ))}
              </div>
            )}
          </div>
        </li>
      );
    })}
  </ul>
</BaseLayout>
