---
import { render } from 'astro:content';
import ReadingLayout from '../../layouts/ReadingLayout.astro';
import { withBase, absUrl, fmtLong, isoDate } from '../../lib/site';
import { getGuideSorted, getGuideGraph } from '../../lib/content';
import { articleNode } from '../../lib/jsonld';

// Topic hub: the evergreen section plus everything the site knows about the
// topic — the claims that implement it, the examples that evidence it,
// and the dated coverage that mentions it. The graph is inverted once per
// build in lib/content.ts.
export async function getStaticPaths() {
  const [guide, graph] = await Promise.all([getGuideSorted(), getGuideGraph()]);
  return guide.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: i > 0 ? guide[i - 1] : null,
      next: i < guide.length - 1 ? guide[i + 1] : null,
      claims: graph.claimsBySection.get(entry.id) ?? [],
      examples: graph.examplesBySection.get(entry.id) ?? [],
      skills: graph.skillsBySection.get(entry.id) ?? [],
      coverage: graph.coverageBySection.get(entry.id) ?? [],
    },
  }));
}

const { entry, prev, next, claims, examples, skills, coverage } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const stamp = `Section ${String(d.order).padStart(2, '0')}`;
const KIND_LABEL = { article: 'article', issue: 'the week', dive: 'deep dive', radar: 'radar', signal: 'signal' };
---
<ReadingLayout
  title={d.title}
  description={d.summary}
  deskLabel="Guide"
  stamp={stamp}
  updated={d.updated}
  jsonLd={[
    // Continuously-maintained reference: dateModified only, no invented
    // publish date.
    articleNode({
      schemaType: 'TechArticle',
      title: d.title,
      description: d.summary,
      url: absUrl(`/guide/${entry.id}`),
      updated: d.updated,
      section: 'Guide',
    }),
  ]}
>
  <div class="entry-lead" slot="lead">
    <span>last checked <time datetime={isoDate(d.updated)}>{fmtLong(d.updated)}</time></span>
  </div>

  <Content />

  <Fragment slot="foot">
    <div class="hub">
      {claims.length > 0 && (
        <div class="hub-sec">
          <p class="hub-h">Claims <span class="ar-count">{claims.length}</span></p>
          <ul class="hub-list">
            {claims.map((p) => (
              <li class="hub-item">
                <a href={withBase(`/claims#${p.id}`)}>{p.data.title}</a>
                {p.data.status !== 'current' && (
                  <span class={`claim-status claim-status-${p.data.status}`}>{p.data.status}</span>
                )}
                {p.data.since && <span class="hub-m">since {p.data.since}</span>}
                <span class="hub-m">checked {isoDate(p.data.checked)}</span>
                <span class="hub-sub">when {p.data.when} → {p.data.do}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {examples.length > 0 && (
        <div class="hub-sec">
          <p class="hub-h">Evidence <span class="ar-count">{examples.length}</span></p>
          <ul class="hub-list">
            {examples.map((e) => (
              <li class="hub-item">
                <a href={withBase(`/examples#${e.id}`)}>{e.data.company}: {e.data.title}</a>
                <span class="hub-m">{e.data.artifact}</span>
                <span class="hub-sub">{e.data.summary}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {skills.length > 0 && (
        <div class="hub-sec">
          <p class="hub-h">Automate it <span class="ar-count">{skills.length}</span></p>
          <ul class="hub-list">
            {skills.map((s) => (
              <li class="hub-item">
                <a href={withBase(`/skills#${s.id}`)}>{s.data.name}</a>
                <span class="hub-m">{s.data.repo}</span>
                <span class="hub-sub">{s.data.summary}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {coverage.length > 0 && (
        <div class="hub-sec">
          <p class="hub-h">Coverage <span class="ar-count">{coverage.length}</span></p>
          <ul class="hub-list">
            {coverage.map((c) => (
              <li class="hub-item">
                <a href={withBase(c.href)}>{c.title}</a>
                <span class="hub-m">{KIND_LABEL[c.kind]} · {isoDate(c.date)}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <nav class="section-nav">
      {prev ? (
        <a href={withBase(`/guide/${prev.id}`)}>← {prev.data.title}</a>
      ) : (
        <a href={withBase('/guide')}>← contents</a>
      )}
      <span class="spacer"></span>
      {next ? (
        <a href={withBase(`/guide/${next.id}`)}>{next.data.title} →</a>
      ) : (
        <a href={withBase('/issues')}>the week →</a>
      )}
    </nav>
  </Fragment>
</ReadingLayout>
