---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterCta from '../components/NewsletterCta.astro';
import { withBase, fmtMed, isoDate } from '../lib/site';
import {
  getGuideSorted,
  getIssuesSorted,
  getDivesSorted,
  getExamplesSorted,
  getClaimsSorted,
  getSkillsSorted,
  getArticlesSorted,
  getResourcesSorted,
  getWireSorted,
  WIRE_KIND_LABELS,
  DESK_LABELS,
} from '../lib/content';

// The edition. One merged, dated stream of published pieces decides the
// hierarchy: the freshest piece leads (an article most days, The Week on
// Mondays), the next two get the secondary boxes, the rest run on the wire.
const [guide, weekly, dives, examples, practices, skills, articles, resources, allBriefs] =
  await Promise.all([
    getGuideSorted(),
    getIssuesSorted(),
    getDivesSorted(),
    getExamplesSorted(),
    getClaimsSorted(),
    getSkillsSorted(),
    getArticlesSorted(),
    getResourcesSorted(),
    getWireSorted(),
  ]);

// The ticker is a *view* over /wire, never the home of the content: every
// item is a real link present in the DOM, so agents, search and no-JS readers
// lose nothing by ignoring the animation. Capped because a ticker is a teaser —
// the full wire is one click away.
const ticker = allBriefs.slice(0, 12);

type Piece = {
  kind: 'article' | 'issue' | 'dive';
  glyph: string;
  chip: string;
  kicker: string;
  title: string;
  summary: string;
  href: string;
  date: Date;
};

const stream: Piece[] = [
  ...articles.map((a) => ({
    kind: 'article' as const,
    glyph: '▸',
    chip: DESK_LABELS[a.data.desk],
    kicker: `${DESK_LABELS[a.data.desk]} · ${a.data.byline}`,
    title: a.data.title,
    summary: a.data.summary,
    href: `/articles/${a.id}`,
    date: a.data.date,
  })),
  ...weekly.map((w) => ({
    kind: 'issue' as const,
    glyph: '≋',
    chip: 'The Week',
    kicker: `The Week · ${w.data.week}`,
    title: w.data.title,
    summary: w.data.summary,
    href: `/issues/${w.id}`,
    date: w.data.date,
  })),
  ...dives.map((d) => ({
    kind: 'dive' as const,
    glyph: '◈',
    chip: 'Deep Dive',
    kicker: 'Deep Dive',
    title: d.data.title,
    summary: d.data.summary,
    href: `/deep-dives/${d.id}`,
    date: d.data.date,
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime() || a.href.localeCompare(b.href));

const lead = stream[0];
const secondary = stream.slice(1, 3);
const wire = stream.slice(3, 11);

// Dateline: the site rebuilds on every editorial commit, so build time ≈ today.
const now = new Date();
const dateline = now
  .toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })
  .toUpperCase();
const weekAgo = now.getTime() - 7 * 86400e3;
const freshCount = stream.filter((p) => p.date.getTime() >= weekAgo).length;

const latestIssue = weekly[0];
const guideUpdated = guide.reduce<Date | null>(
  (max, g) => (max && max > g.data.updated ? max : g.data.updated),
  null
);
const deskCounts = (['news', 'money', 'campaigns', 'research', 'technology'] as const)
  .map((d) => ({ desk: d, label: DESK_LABELS[d], n: articles.filter((a) => a.data.desk === d).length }))
  .filter((d) => d.n > 0);
---
<BaseLayout title="Developer Marketing" home>
  <div class="fm fm--v2">
    <div class="fm-date">
      <b>{dateline}</b>
      {freshCount > 0 && <span>{freshCount} new this week</span>}
      <span class="fm-date-sp"></span>
      <a href={withBase('/feed.xml')}>≋ feed</a>
    </div>

    {ticker.length > 0 && (
      <section class="tick" aria-labelledby="tick-h">
        <h2 class="tick-h" id="tick-h">
          <a href={withBase('/wire')}>the wire</a>
        </h2>
        <div class="tick-vp">
          <ul class="tick-run">
            {ticker.map((b) => (
              <li class="tick-i">
                <a href={withBase(`/wire#${b.id}`)}>
                  <span class="tick-co">{b.data.company}</span>
                  <span class="tick-k">{WIRE_KIND_LABELS[b.data.kind]}</span>
                  <span class="tick-t">{b.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <div class="fm2-grid">
      <div class="fm2-main">
        {lead ? (
          <a href={withBase(lead.href)} class="fm-box" data-date={isoDate(lead.date)}>
            <span class="fm-legend">{lead.kind === 'issue' ? 'THE WEEK' : lead.kind === 'dive' ? 'DEEP DIVE' : 'THE LEAD'}</span>
            <div class="fm-kick">
              <span class="amber"># </span>
              {lead.kind === 'article' && <Fragment><span class="kind-inline">{lead.kicker}</span> · </Fragment>}
              {lead.kind === 'issue' && <Fragment><span class="kind-inline">{lead.kicker.replace('The Week · ', '')}</span> · </Fragment>}
              {fmtMed(lead.date)}
            </div>
            <h1 class="fm-h">{lead.title}</h1>
            <p class="fm-dek">{lead.summary}</p>
            <span class="fm-read"><span class="amber">→</span> read</span>
          </a>
        ) : (
          <a href={withBase('/guide')} class="fm-box">
            <span class="fm-legend">THE GUIDE</span>
            <div class="fm-kick"><span class="amber"># </span><span class="kind-inline">evergreen</span> · {guide.length} sections</div>
            <h1 class="fm-h">The state of the art in developer marketing</h1>
            <p class="fm-dek">
              The first edition is in the works — meanwhile the guide is the
              product: positioning, docs, DevRel, DX, distribution, launches,
              and measurement, each section stamped with the date it was last
              checked.
            </p>
            <span class="fm-read"><span class="amber">→</span> read the guide</span>
          </a>
        )}

        {secondary.length > 0 && (
          <div class="fm-duo">
            {secondary.map((p) => (
              <a href={withBase(p.href)} class="fm-box fm-box--sec" data-date={isoDate(p.date)}>
                <div class="fm-kick"><span class="kind-inline">{p.chip}</span> · {fmtMed(p.date)}</div>
                <h2 class="fm-h2">{p.title}</h2>
                <p class="fm-dek">{p.summary}</p>
              </a>
            ))}
          </div>
        )}

        {wire.length > 0 && (
          <Fragment>
            <div class="fm-sec">
              <span class="amber">##</span><span class="fm-sec-l">the wire</span>
              <span class="fm-rule" aria-hidden="true"></span>
              <span class="dim">{String(stream.length).padStart(2, '0')}</span>
            </div>
            <ul class="fd-list">
              {wire.map((p) => (
                <li class="fd-row" data-date={isoDate(p.date)}>
                  <span class="fd-ln">{isoDate(p.date).slice(5)}</span>
                  <div class="fd-main">
                    <a href={withBase(p.href)} class="fd-t"><span class="wire-kind" aria-hidden="true">{p.glyph}</span>{p.title}</a>
                    <div class="fd-m">
                      <span class="fd-beatlabel">{p.chip}</span>
                      <span>{p.summary}</span>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
            <div class="fm-keys" style="border-top:0;margin-top:10px;padding-top:0">
              <a href={withBase('/articles')}>all articles →</a>
              <a href={withBase('/issues')}>all issues →</a>
              <a href={withBase('/deep-dives')}>all dives →</a>
            </div>
          </Fragment>
        )}
      </div>

      <aside class="fm-rail">
        <NewsletterCta variant="rail" source="/" />

        {latestIssue && (
          <div class="rail-box">
            <span class="rail-legend">THE WEEK</span>
            <p class="rail-meta">{latestIssue.data.week} · {fmtMed(latestIssue.data.date)}</p>
            <a href={withBase(`/issues/${latestIssue.id}`)} class="rail-t">{latestIssue.data.title}</a>
            <p class="rail-dek">{latestIssue.data.summary}</p>
            <a href={withBase('/issues')} class="rail-more">all issues →</a>
          </div>
        )}

        <div class="rail-box">
          <span class="rail-legend">THE HANDBOOK</span>
          <p class="rail-meta">
            {guide.length} sections, kept current{guideUpdated && ` · upd ${isoDate(guideUpdated)}`}
          </p>
          <ul class="rail-list">
            {guide.map((g) => (
              <li>
                <a href={withBase(`/guide/${g.id}`)}><span class="ln">{String(g.data.order).padStart(2, '0')}</span>{g.data.title}</a>
              </li>
            ))}
          </ul>
          <a href={withBase('/guide')} class="rail-more">open the manual →</a>
        </div>

        <div class="rail-box">
          <span class="rail-legend">THE DESKS</span>
          {deskCounts.length > 0 ? (
            <p class="rail-counts">
              {deskCounts.map((d) => (
                <span>{d.label.toLowerCase()} <b>{d.n}</b></span>
              ))}
            </p>
          ) : (
            <p class="rail-dek">
              Five desks — news, money, campaigns, research, technology — one
              article a day at most, only when the story earns it.
            </p>
          )}
          <a href={withBase('/articles')} class="rail-more">the newsroom →</a>
        </div>

        <div class="rail-box">
          <span class="rail-legend">REFERENCE</span>
          <p class="rail-counts">
            <span>claims <b>{practices.length}</b></span>
            <span>examples <b>{examples.length}</b></span>
            <span>skills <b>{skills.length}</b></span>
            <span>resources <b>{resources.length}</b></span>
          </p>
          <ul class="rail-list" style="margin-top:8px">
            <li><a href={withBase('/claims')}><span class="ln">»</span>when X → do Y, dated and sourced</a></li>
            <li><a href={withBase('/examples')}><span class="ln">❏</span>the swipe file of real artifacts</a></li>
            <li><a href={withBase('/skills')}><span class="ln">⌗</span>agent skills you can install today</a></li>
            <li><a href={withBase('/resources')}><span class="ln">⌾</span>who to hire, vetted and unpaid-for</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <footer class="fm-keys">
      <a href={withBase('/guide')}><b>g&thinsp;g</b> guide</a>
      <a href={withBase('/articles')}><b>g&thinsp;n</b> newsroom</a>
      <a href={withBase('/issues')}><b>g&thinsp;w</b> the week</a>
      <a href={withBase('/deep-dives')}><b>g&thinsp;d</b> deep dives</a>
      <a href={withBase('/claims')}><b>g&thinsp;p</b> claims</a>
      <a href={withBase('/examples')}><b>g&thinsp;e</b> examples</a>
      <a href={withBase('/skills')}><b>g&thinsp;s</b> skills</a>
      <a href={withBase('/resources')}><b>g&thinsp;o</b> resources</a>
      <a href={withBase('/radar')}><b>g&thinsp;r</b> radar archive</a>
      <a href={withBase('/about')}><b>g&thinsp;a</b> about</a>
      <a href={withBase('/newsletter')}><b>g&thinsp;m</b> newsletter</a>
      <a href={withBase('/feed.xml')}><b>≋</b> feed</a>
    </footer>
  </div>

  <script is:inline>
    (function () {
      try {
        var KEY = 'sota-seen';
        var rows = [].slice.call(document.querySelectorAll('[data-date]'));
        if (!rows.length) return;
        var prev = localStorage.getItem(KEY);
        var max = prev || '';
        rows.forEach(function (el) {
          var d = el.getAttribute('data-date');
          if (d > max) max = d;
          if (prev && d > prev) el.classList.add('is-new');
        });
        localStorage.setItem(KEY, max);
      } catch (e) {}
    })();
  </script>

  <script is:inline>
    // Seamless wire ticker. The markup ships one copy of the run — enough on
    // its own as a scrollable strip — and this duplicates it so the CSS
    // translateX(-50%) loop has something to loop through. The copy is
    // aria-hidden and its links are removed from the tab order, so assistive
    // tech and keyboard users see each brief exactly once.
    (function () {
      try {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var run = document.querySelector('.tick-run');
        if (!run || run.children.length === 0) return;
        // Snapshot before appending: children is a *live* collection, and
        // moving a node out of it while iterating shifts every later index,
        // which silently duplicates only half the run.
        var copy = Array.prototype.slice.call(run.cloneNode(true).children);
        copy.forEach(function (li) {
          li.setAttribute('aria-hidden', 'true');
          var a = li.querySelector('a');
          if (a) a.setAttribute('tabindex', '-1');
          run.appendChild(li);
        });
        run.classList.add('is-looping');
      } catch (e) {}
    })();
  </script>
</BaseLayout>
