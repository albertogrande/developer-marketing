---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase, fmtWeekRange, isoDate } from '../lib/site';
import { getGuideSorted, getIssuesSorted, getSignalsSorted, SIGNAL_KIND_LABELS } from '../lib/content';
import { NEWSLETTER, NEWSLETTER_LIVE, SUBSCRIBE_URL } from '../lib/newsletter';

// Front v3 — one column, three markdown-headed sections: ## The Beat (the
// week's issue), ## Signals (the event timeline), ## The Guide (the
// reference index), then the newsletter form. The previous front (v2) is
// backed up in design-backups/2026-08-06-front-v2/.
const [guide, issues, allWire] = await Promise.all([
  getGuideSorted(),
  getIssuesSorted(),
  getSignalsSorted(),
]);

const lead = issues[0];

// The signals, grouped into days for the timeline. Capped — the full signals is one
// click away, and every item here is a real link (no ticker, no animation).
const signalDays: { date: Date; items: typeof allWire }[] = [];
for (const b of allWire.slice(0, 14)) {
  const last = signalDays[signalDays.length - 1];
  if (last && isoDate(last.date) === isoDate(b.data.date)) last.items.push(b);
  else signalDays.push({ date: b.data.date, items: [b] });
}

// The source domain is trust furniture: shown on every signals row so "sourced,
// dated, verified" is visible on the front, not just claimed on /about.
const srcHost = (url: string) => new URL(url).hostname.replace(/^www\./, '');

// One line per event. The signals' summaries run two full sentences — right on
// /signals, a wall in a timeline — so the front shows the opening sentence cut to
// what fits on one line at this width. It closes on a clause boundary and ends
// in a full stop: a short true sentence, never a trailing "…". 108 chars is
// the budget at 12px JetBrains Mono inside the 940px wrap.
const LINE_MAX = 108;
// Words that leave a cut dangling ("…wrap your MCP server to.") — dropped from
// the tail until the sentence stands on its own.
const DANGLING = new Set(
  ('a an and as at but by for from in into of on or that the to with its it this their there was were is are be' +
    ' has have had not no so than then when while which who whose over under after before since per via up out about')
    .split(' ')
);

function oneLine(summary: string): string {
  const first = summary.split(/(?<=[.!?])\s+/)[0].trim();
  if (first.length <= LINE_MAX) return first;

  const head = first.slice(0, LINE_MAX);
  // Prefer a real clause break; only fall back to a word break if the nearest
  // one sits in the first half, where cutting would throw away too much.
  const clause = Math.max(head.lastIndexOf(' — '), head.lastIndexOf('; '), head.lastIndexOf(', '));
  let body: string;
  if (clause > LINE_MAX / 2) body = head.slice(0, clause);
  // The budget may land exactly on a word end; only chop back when it doesn't,
  // or a whole good word is thrown away.
  else if (/\s/.test(first.charAt(LINE_MAX))) body = head;
  else body = head.slice(0, head.lastIndexOf(' '));

  // A cut inside a quotation or parenthetical leaves the mark hanging open;
  // fall back to the text before it opened.
  for (const [open, close] of [['"', '"'], ['(', ')'], ['“', '”']] as const) {
    const opened = body.split(open).length - 1;
    const closed = open === close ? opened : body.split(close).length - 1;
    if (open === close ? opened % 2 === 1 : opened > closed) body = body.slice(0, body.lastIndexOf(open));
  }

  let prev = '';
  while (body !== prev) {
    prev = body;
    body = body.replace(/[\s,;:—-]+$/, '');
    const tail = body.slice(body.lastIndexOf(' ') + 1).toLowerCase();
    if (DANGLING.has(tail)) body = body.slice(0, body.lastIndexOf(' '));
  }
  return /[.!?]$/.test(body) ? body : body + '.';
}

// "Fresh" markers key off build time; the site rebuilds on every editorial
// commit, so build time ≈ today.
const weekAgo = Date.now() - 7 * 86400e3;

const freshGuide = (updated: Date) => updated.getTime() >= weekAgo;
---
<BaseLayout title="The Beat" home>
  <div class="fm fm--v3">
    {/* No "## The Beat" header — the site name is already the nameplate, and
        the framed lead announces itself. */}
    <section aria-label="The latest issue">
      {lead ? (
        <article class="v3-lead" data-date={isoDate(lead.data.published)}>
          <span class="v3-lead-legend" aria-hidden="true">latest issue</span>
          <p class="v3-kick">
            <b>issue {lead.data.week}</b> · {fmtWeekRange(lead.data.date, 'med')}
          </p>
          <h1 class="fm-h v3-lead-h">
            <a href={withBase(`/issues/${lead.id}`)}>{lead.data.title}</a>
          </h1>
          <p class="fm-dek v3-lead-dek">{lead.data.dek ?? lead.data.summary}</p>
          <a class="v3-read" href={withBase(`/issues/${lead.id}`)}><span class="amber">→</span> read the issue</a>
        </article>
      ) : (
        <article class="v3-lead">
          <p class="v3-kick"><span class="amber" aria-hidden="true">###</span><b>the guide</b> · evergreen · {guide.length} sections</p>
          <h1 class="fm-h v3-lead-h">
            <a href={withBase('/guide')}>The state of the art in developer marketing</a>
          </h1>
          <p class="fm-dek v3-lead-dek">
            The first issue is in the works — meanwhile the guide is the
            product: positioning, docs, DevRel, DX, distribution, launches,
            and measurement, each section stamped with the date it was last
            checked.
          </p>
          <a class="v3-read" href={withBase('/guide')}><span class="amber">→</span> read the guide</a>
        </article>
      )}
    </section>

    {signalDays.length > 0 && (
      <section aria-labelledby="v3-signals-h">
        <h2 class="v3-sec" id="v3-signals-h">
          <span class="amber" aria-hidden="true">##</span>
          <span class="v3-sec-l"><a href={withBase('/signals')}>Signals</a></span>
          <span class="v3-rule" aria-hidden="true"></span>
        </h2>
        <ol class="v3-tl">
          {signalDays.map((day) => (
            <li class="v3-day">
              <p class="v3-day-d">{isoDate(day.date)}</p>
              <ul class="v3-day-list">
                {day.items.map((b) => (
                  <li class="v3-ev" data-date={isoDate(b.data.date)}>
                    <a class="v3-ev-t" href={withBase(`/signals#${b.id}`)}>
                      <span class="v3-ev-co">{b.data.company}</span>: {b.data.title}
                    </a>
                    <p class="v3-ev-m">
                      {b.data.kind !== 'signal' && (
                        <>
                          <span class="fd-beatlabel">{SIGNAL_KIND_LABELS[b.data.kind]}</span>
                          <span class="dim" aria-hidden="true">·</span>
                        </>
                      )}
                      <a class="v3-ev-src" href={b.data.source.url} rel="noopener">{srcHost(b.data.source.url)} ↗</a>
                    </p>
                    <p class="v3-ev-s">{oneLine(b.data.summary)}</p>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
        <a class="v3-more" href={withBase('/signals')}>all signals →</a>
      </section>
    )}

    <section aria-labelledby="v3-guide-h">
      <h2 class="v3-sec" id="v3-guide-h">
        <span class="amber" aria-hidden="true">##</span>
        <span class="v3-sec-l"><a href={withBase('/guide')}>The Guide</a></span>
        <span class="v3-rule" aria-hidden="true"></span>
      </h2>
      <ul class="v3-glist">
        {guide.map((g) => (
          <li>
            <span class="ln">{String(g.data.order).padStart(2, '0')}</span>
            <a href={withBase(`/guide/${g.id}`)}>{g.data.title}</a>
            <span class={`v3-upd${freshGuide(g.data.updated) ? ' is-fresh' : ''}`}>
              {isoDate(g.data.updated).slice(5)}{freshGuide(g.data.updated) && ' ●'}
            </span>
          </li>
        ))}
      </ul>
      <a class="v3-more" href={withBase('/guide')}>open the guide →</a>
    </section>

    {/* Newsletter — a terminal window. The form renders whether or not a
        capture endpoint is configured; unset, submitting says so honestly
        instead of swallowing the address. */}
    <section class="v3-nl" aria-labelledby="v3-nl-h">
      <div class="v3-nl-bar" aria-hidden="true">
        <span class="v3-nl-dot d1"></span>
        <span class="v3-nl-dot d2"></span>
        <span class="v3-nl-dot d3"></span>
        <span class="v3-nl-title">mail — the beat</span>
      </div>
      <div class="v3-nl-body">
        <h2 class="v3-nl-cmd" id="v3-nl-h">
          <span class="amber">$</span> the-beat subscribe <span class="dim">--weekly</span><span class="cur" aria-hidden="true">▌</span>
        </h2>
        <p class="v3-nl-p">{NEWSLETTER.promise}</p>
        <form class="v3-nl-form" method="post" action={SUBSCRIBE_URL || undefined} data-v3-nl novalidate>
          <label class="sr-only" for="v3-nl-email">Email address</label>
          <span class="v3-nl-prompt" aria-hidden="true">&gt;</span>
          <input
            class="v3-nl-input"
            id="v3-nl-email"
            type="email"
            name="email"
            inputmode="email"
            autocomplete="email"
            spellcheck="false"
            placeholder="you@company.dev"
            required
          />
          <input type="hidden" name="source" value="/" />
          <input type="hidden" name="rendered_at" value="" data-v3-ts />
          {/* Honeypot: a field a person never sees and a bot cannot resist. */}
          <div class="nl-hp" aria-hidden="true">
            <label for="v3-nl-website">Leave this field empty</label>
            <input id="v3-nl-website" type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <button class="v3-nl-btn" type="submit">subscribe</button>
          <p class="v3-nl-status" role="status" aria-live="polite" data-v3-status></p>
        </form>
        <p class="v3-nl-fine"># {NEWSLETTER.cadence.toLowerCase()} · double opt-in · no tracking pixels · one-click unsubscribe</p>
      </div>
    </section>

    {/* The four doors the chrome nav carries, and the feed. Every other
        shortcut still works and is still listed under `?` and in ⌘K — the
        footer advertises the way in, not the whole keymap. */}
    <footer class="fm-keys">
      <a href={withBase('/signals')}><b>g&thinsp;i</b> signals</a>
      <a href={withBase('/issues')}><b>g&thinsp;w</b> the week</a>
      <a href={withBase('/guide')}><b>g&thinsp;g</b> guide</a>
      <a href={withBase('/about')}><b>g&thinsp;a</b> about</a>
      <a href={withBase('/feed.xml')}><b>≋</b> feed</a>
    </footer>
  </div>

  <script is:inline define:vars={{ live: NEWSLETTER_LIVE }}>
    // The subscribe form. With an endpoint it posts JSON and answers in place;
    // without one it says the sign-up is not wired up rather than pretending.
    (function () {
      var form = document.querySelector('[data-v3-nl]');
      if (!form) return;
      var ts = form.querySelector('[data-v3-ts]');
      if (ts) ts.value = String(Date.now());

      function say(msg, kind) {
        var el = form.querySelector('[data-v3-status]');
        if (!el) return;
        el.textContent = msg;
        el.className = 'v3-nl-status' + (kind ? ' is-' + kind : '');
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var email = (form.elements.email.value || '').trim();
        if (!email || email.indexOf('@') < 1 || email.length > 254) {
          say('that does not look like an email address.', 'err');
          form.elements.email.focus();
          return;
        }
        if (!live) {
          say('sign-up is not wired up on this build — the feed carries every issue.', 'err');
          return;
        }

        var btn = form.querySelector('.v3-nl-btn');
        if (btn) { btn.disabled = true; btn.textContent = 'sending…'; }
        say('sending…', '');

        fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({
            email: email,
            source: form.elements.source ? form.elements.source.value : '/',
            website: form.elements.website ? form.elements.website.value : '',
            rendered_at: ts ? Number(ts.value) : 0,
          }),
        })
          .then(function (res) {
            return res.json().catch(function () { return {}; }).then(function (data) {
              return { ok: res.ok, status: res.status, data: data };
            });
          })
          .then(function (r) {
            if (btn) { btn.disabled = false; btn.textContent = 'subscribe'; }
            if (r.ok) {
              form.reset();
              if (ts) ts.value = String(Date.now());
              say('check your inbox — confirm the link and you are on the list.', 'ok');
            } else if (r.status === 429) {
              say('too many attempts. try again in a few minutes.', 'err');
            } else {
              say((r.data && r.data.error) || 'that did not go through. try again shortly.', 'err');
            }
          })
          .catch(function () {
            if (btn) { btn.disabled = false; btn.textContent = 'subscribe'; }
            say('network error — the subscribe service did not answer.', 'err');
          });
      });
    })();
  </script>

  <script is:inline>
    (function () {
      try {
        var KEY = 'sota-seen';
        var rows = [].slice.call(document.querySelectorAll('[data-date]'));
        if (!rows.length) return;
        var prev = localStorage.getItem(KEY);
        var max = prev || '';
        rows.forEach(function (el) {
          var d = el.getAttribute('data-date');
          if (d > max) max = d;
          if (prev && d > prev) el.classList.add('is-new');
        });
        localStorage.setItem(KEY, max);
      } catch (e) {}
    })();
  </script>
</BaseLayout>
