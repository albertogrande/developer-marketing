---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import { withBase, absUrl, isoDate } from '../../lib/site';
import { getRadarSorted } from '../../lib/content';
import { collectionPageNode } from '../../lib/jsonld';

const radar = await getRadarSorted();
---
<BaseLayout
  title="Radar (archive)"
  description="The archived radar — dated posts on developer marketing, DevRel, and developer experience from the site's first phase. The cadence now lives in the weekly."
  jsonLd={[
    collectionPageNode({
      name: 'Radar archive',
      description:
        "The archived radar — dated posts on developer marketing, DevRel, and developer experience from the site's first phase. The cadence now lives in the weekly.",
      url: absUrl('/radar'),
      items: radar.map((r) => ({ name: r.data.title, url: absUrl(`/radar/${r.id}`) })),
    }),
  ]}
>
  <div class="page-head">
    <div class="kicker"><span class="prompt" aria-hidden="true">&gt;</span> radar</div>
    <h1 class="page-title">The radar archive</h1>
    <p class="dek">
      The site's first phase published one dated post a day; they're preserved
      here, newest first, each one sourced. Daily capture now feeds an internal
      signals file, and the published cadence is
      <a href={withBase('/issues')}>the week</a>.
    </p>
  </div>

  <ul class="ar-list">
    {radar.map((d) => (
      <li class="ar-row">
        <span class="ar-date">{isoDate(d.data.date)}</span>
        <div class="ar-main">
          <div class="ar-head">
            <span class="kind">{d.data.kind}</span>
            <a href={withBase(`/radar/${d.id}`)} class="ar-title">{d.data.title}</a>
          </div>
          <span class="ar-meta">{d.data.summary}</span>
          <TagList tags={d.data.tags} style="margin-top:8px" />
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
