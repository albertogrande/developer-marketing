---
import { getCollection, render } from 'astro:content';
import ReadingLayout from '../../layouts/ReadingLayout.astro';
import ArchiveNotice from '../../components/ArchiveNotice.astro';
import ArticleFoot from '../../components/ArticleFoot.astro';
import TagList from '../../components/TagList.astro';
import { absUrl, fmtLong } from '../../lib/site';
import { articleNode } from '../../lib/jsonld';

export async function getStaticPaths() {
  const radar = await getCollection('radar');
  return radar.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<ReadingLayout
  title={d.title}
  description={d.summary}
  deskLabel="Radar · archive"
  stamp={fmtLong(d.date)}
  published={d.date}
  jsonLd={[
    articleNode({
      schemaType: 'Article',
      title: d.title,
      description: d.summary,
      url: absUrl(`/radar/${entry.id}`),
      published: d.date,
      section: 'Radar archive',
      tags: d.tags,
      sources: d.sources,
    }),
  ]}
>
  <div class="entry-lead" slot="lead">
    <ArchiveNotice now="daily capture moved to the signals" />
    <span class="kind">{d.kind}</span>
    <TagList tags={d.tags} />
  </div>

  <Content />

  {d.take && (
    <div class="note-box take">
      <p class="note-k">The take</p>
      <p>{d.take}</p>
    </div>
  )}

  <ArticleFoot
    slot="foot"
    related={d.related}
    sources={d.sources}
    backHref="/radar"
    backLabel="the radar archive"
    forwardHref="/guide"
    forwardLabel="the guide"
  />
</ReadingLayout>
