---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase, absUrl, isoDate } from '../../lib/site';
import { collectByTag } from '../../lib/content';
import { collectionPageNode } from '../../lib/jsonld';

export async function getStaticPaths() {
  const map = await collectByTag();
  return [...map.keys()].sort().map((tag) => ({
    params: { tag },
    props: { items: map.get(tag)! },
  }));
}

const { tag } = Astro.params;
const { items } = Astro.props;

const weekly = items.filter((i) => i.kind === 'issue');
const articles = items.filter((i) => i.kind === 'article');
const dives = items.filter((i) => i.kind === 'deep-dive');
const practices = items.filter((i) => i.kind === 'claim');
const examples = items.filter((i) => i.kind === 'example');
const resources = items.filter((i) => i.kind === 'resource');
const skills = items.filter((i) => i.kind === 'skill');
const briefs = items.filter((i) => i.kind === 'signals');
const radar = items.filter((i) => i.kind === 'radar');

// Every tagged thing, at its page or gallery-anchor URL.
const taggedUrl = (i: (typeof items)[number]) =>
  ({
    issue: absUrl(`/issues/${i.entry.id}`),
    article: absUrl(`/articles/${i.entry.id}`),
    'deep-dive': absUrl(`/deep-dives/${i.entry.id}`),
    claim: `${absUrl('/claims')}#${i.entry.id}`,
    example: `${absUrl('/examples')}#${i.entry.id}`,
    skill: `${absUrl('/skills')}#${i.entry.id}`,
    resource: `${absUrl('/resources')}#${i.entry.id}`,
    signals: `${absUrl('/signals')}#${i.entry.id}`,
    radar: absUrl(`/radar/${i.entry.id}`),
  })[i.kind];

// Resources are named, everything else is titled.
const taggedName = (i: (typeof items)[number]) =>
  i.kind === 'resource' ? i.entry.data.name : i.entry.data.title;
---
<BaseLayout
  title={`Tagged: ${tag}`}
  description={`Everything on the field guide tagged "${tag}" — issues, claims, examples, skills, signals, and the archives.`}
  jsonLd={[
    collectionPageNode({
      name: `Tagged: ${tag}`,
      description: `Everything on the field guide tagged "${tag}".`,
      url: absUrl(`/tags/${tag}`),
      items: items.map((i) => ({ name: taggedName(i), url: taggedUrl(i) })),
    }),
  ]}
>
  <div class="page-head">
    <div class="kicker"><span class="prompt" aria-hidden="true">&gt;</span> tags / {tag}</div>
    <h1 class="page-title">#{tag}</h1>
    <p class="dek">
      {items.length} item{items.length === 1 ? '' : 's'} ·
      <a href={withBase('/tags')}>all tags</a>
    </p>
  </div>

  {practices.length > 0 && (
    <Fragment>
      <div class="fm-sec">
        <span class="amber">##</span><span class="fm-sec-l">claims</span>
        <span class="fm-rule" aria-hidden="true"></span>
        <span class="dim">{String(practices.length).padStart(2, '0')}</span>
      </div>
      <ul class="fm-list">
        {practices.map(({ entry }) => (
          <li class="fm-row">
            <span class="fm-ln">pr</span>
            <div class="fm-rowmain">
              <a href={withBase(`/claims#${entry.id}`)} class="fm-row-t">{entry.data.title}</a>
              <p class="fm-row-dek">{entry.data.when}</p>
            </div>
          </li>
        ))}
      </ul>
    </Fragment>
  )}

  {examples.length > 0 && (
    <Fragment>
      <div class="fm-sec">
        <span class="amber">##</span><span class="fm-sec-l">examples</span>
        <span class="fm-rule" aria-hidden="true"></span>
        <span class="dim">{String(examples.length).padStart(2, '0')}</span>
      </div>
      <ul class="fm-list">
        {examples.map(({ entry }) => (
          <li class="fm-row">
            <span class="fm-ln">ex</span>
            <div class="fm-rowmain">
              <a href={withBase(`/examples#${entry.id}`)} class="fm-row-t">{entry.data.title}</a>
              <p class="fm-row-dek">{entry.data.summary}</p>
            </div>
          </li>
        ))}
      </ul>
    </Fragment>
  )}

  {resources.length > 0 && (
    <Fragment>
      <div class="fm-sec">
        <span class="amber">##</span><span class="fm-sec-l">outside help</span>
        <span class="fm-rule" aria-hidden="true"></span>
        <span class="dim">{String(resources.length).padStart(2, '0')}</span>
      </div>
      <ul class="fm-list">
        {resources.map(({ entry }) => (
          <li class="fm-row">
            <span class="fm-ln">hire</span>
            <div class="fm-rowmain">
              <a href={withBase(`/resources#${entry.id}`)} class="fm-row-t">{entry.data.name}</a>
              <p class="fm-row-dek">{entry.data.signal}</p>
            </div>
          </li>
        ))}
      </ul>
    </Fragment>
  )}

  {skills.length > 0 && (
    <Fragment>
      <div class="fm-sec">
        <span class="amber">##</span><span class="fm-sec-l">skills</span>
        <span class="fm-rule" aria-hidden="true"></span>
        <span class="dim">{String(skills.length).padStart(2, '0')}</span>
      </div>
      <ul class="fm-list">
        {skills.map(({ entry }) => (
          <li class="fm-row">
            <span class="fm-ln">sk</span>
            <div class="fm-rowmain">
              <a href={withBase(`/skills#${entry.id}`)} class="fm-row-t">{entry.data.title}</a>
              <p class="fm-row-dek">{entry.data.summary}</p>
            </div>
          </li>
        ))}
      </ul>
    </Fragment>
  )}

  {articles.length > 0 && (
    <Fragment>
      <div class="fm-sec">
        <span class="amber">##</span><span class="fm-sec-l">the newsroom</span>
        <span class="fm-rule" aria-hidden="true"></span>
        <span class="dim">{String(articles.length).padStart(2, '0')}</span>
      </div>
      <ul class="fm-list">
        {articles.map(({ entry }) => (
          <li class="fm-row">
            <span class="fm-ln">{isoDate(entry.data.date).slice(5)}</span>
            <div class="fm-rowmain">
              <a href={withBase(`/articles/${entry.id}`)} class="fm-row-t">{entry.data.title}</a>
              <p class="fm-row-dek">{entry.data.summary}</p>
            </div>
          </li>
        ))}
      </ul>
    </Fragment>
  )}

  {briefs.length > 0 && (
    <Fragment>
      <div class="fm-sec">
        <span class="amber">##</span><span class="fm-sec-l">signals</span>
        <span class="fm-rule" aria-hidden="true"></span>
        <span class="dim">{String(briefs.length).padStart(2, '0')}</span>
      </div>
      <ul class="fm-list">
        {briefs.map(({ entry }) => (
          <li class="fm-row">
            <span class="fm-ln">{isoDate(entry.data.date).slice(5)}</span>
            <div class="fm-rowmain">
              <a href={withBase(`/signals#${entry.id}`)} class="fm-row-t">{entry.data.company}: {entry.data.title}</a>
              <p class="fm-row-dek">{entry.data.summary}</p>
            </div>
          </li>
        ))}
      </ul>
    </Fragment>
  )}

  {weekly.length > 0 && (
    <Fragment>
      <div class="fm-sec">
        <span class="amber">##</span><span class="fm-sec-l">the week</span>
        <span class="fm-rule" aria-hidden="true"></span>
        <span class="dim">{String(weekly.length).padStart(2, '0')}</span>
      </div>
      <ul class="fm-list">
        {weekly.map(({ entry }) => (
          <li class="fm-row">
            <span class="fm-ln">{entry.data.week.slice(5)}</span>
            <div class="fm-rowmain">
              <a href={withBase(`/issues/${entry.id}`)} class="fm-row-t">{entry.data.title}</a>
              <p class="fm-row-dek">{entry.data.summary}</p>
            </div>
          </li>
        ))}
      </ul>
    </Fragment>
  )}

  {dives.length > 0 && (
    <Fragment>
      <div class="fm-sec">
        <span class="amber">##</span><span class="fm-sec-l">deep dives</span>
        <span class="fm-rule" aria-hidden="true"></span>
        <span class="dim">{String(dives.length).padStart(2, '0')}</span>
      </div>
      <ul class="fm-list">
        {dives.map(({ entry }) => (
          <li class="fm-row">
            <span class="fm-ln">{isoDate(entry.data.date).slice(5)}</span>
            <div class="fm-rowmain">
              <a href={withBase(`/deep-dives/${entry.id}`)} class="fm-row-t">{entry.data.title}</a>
              <p class="fm-row-dek">{entry.data.summary}</p>
            </div>
          </li>
        ))}
      </ul>
    </Fragment>
  )}

  {radar.length > 0 && (
    <Fragment>
      <div class="fm-sec">
        <span class="amber">##</span><span class="fm-sec-l">radar (archive)</span>
        <span class="fm-rule" aria-hidden="true"></span>
        <span class="dim">{String(radar.length).padStart(2, '0')}</span>
      </div>
      <ul class="fm-list">
        {radar.map(({ entry }) => (
          <li class="fm-row">
            <span class="fm-ln">{isoDate(entry.data.date).slice(5)}</span>
            <div class="fm-rowmain">
              <a href={withBase(`/radar/${entry.id}`)} class="fm-row-t">{entry.data.title}</a>
              <p class="fm-row-dek">{entry.data.summary}</p>
            </div>
          </li>
        ))}
      </ul>
    </Fragment>
  )}
</BaseLayout>
