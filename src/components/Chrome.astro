---
// Terminal chrome (inherited from The Wire's mono-grid skin). The mark is
// `$ the beat▌` over a `--flag` nav.
//
// The blinking cursor is the wordmark, not decoration: the publication is
// called The Beat and the block pulses at 1.1s, so the mark keeps time. That
// is the whole joke and it only works with the cursor attached — never ship
// this lockup without it.
//
// Two spellings to keep straight, because they have drifted before: the mark
// is `the beat` with a SPACE (a name being typed), while the newsletter
// form's genuine command line is `the-beat subscribe --weekly` with a HYPHEN
// (a binary being invoked). Both take the `$` prompt; page kickers and the
// favicon use `>` as a list marker instead.
// scripts/build-og.mjs renders the same lockup — re-run it after any change.
import { withBase } from '../lib/site';

interface Props {
  wide?: boolean;
}
// The v2 front page shares the reading wrap, so the chrome is one width now;
// the `wide` prop is accepted for compatibility but no longer changes it.
const max = 'var(--wrap)';

// Six doors: the two stream forms, the reference, the threads that connect
// them, the jobs board, the masthead. Everything else — claims, examples,
// skills, resources, the archives — is reached through the guide, the command
// palette, or footers.
//
// Labels are the bare collection names, matching their URLs; the `--flag`
// prefix is supplied by the template, so nothing here carries an article.
// If this row ever gets too tight, `about` gives before `jobs` — the masthead
// is reachable by `g a`, from the palette and from the footer.
const nav = [
  { label: 'issues', url: '/issues' },
  { label: 'signals', url: '/signals' },
  { label: 'guide', url: '/guide' },
  { label: 'threads', url: '/threads' },
  { label: 'jobs', url: '/jobs' },
  { label: 'about', url: '/about' },
];
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (url: string) => {
  const target = withBase(url).replace(/\/$/, '') || '/';
  return here === target || here.startsWith(target + '/');
};
---
<div class="chrome" style={`max-width:${max}`}>
  <header class="chrome-head">
    <a href={withBase('/')} class="chrome-mark">
      <span class="amber">$</span> the beat<span class="cur" aria-hidden="true">▌</span>
    </a>
    <nav class="chrome-nav" aria-label="Primary">
      {nav.map((n) => (
        <a href={withBase(n.url)} class={isCurrent(n.url) ? 'is-here' : ''} aria-current={isCurrent(n.url) ? 'page' : undefined}>--{n.label}</a>
      ))}
      <button id="open-search" class="chrome-toggle chrome-search" type="button" aria-label="Open command palette (Ctrl or Cmd + K)" title="Commands & search — ⌘K">⌕</button>
      <button id="theme-toggle" class="chrome-toggle" type="button" aria-label="Toggle light or dark theme" aria-pressed="false">◐</button>
    </nav>
  </header>
</div>
