---
// Terminal chrome (inherited from Signals's mono-grid skin). A `$ the-beat`
// mark with a blinking cursor and `--flag` nav.
//
// The mark is a typed command, not a masthead — same binary name the
// newsletter form invokes (`$ the-beat subscribe --weekly`), which is why the
// prompt is `$` while page kickers use `>` as a list marker.
// scripts/build-og.mjs renders a `$ the beat▌` lockup — re-run it to match.
import { withBase } from '../lib/site';

interface Props {
  wide?: boolean;
}
// The v2 front page shares the reading wrap, so the chrome is one width now;
// the `wide` prop is accepted for compatibility but no longer changes it.
const max = 'var(--wrap)';

// Four doors: the two stream forms, the reference, the masthead. Everything
// else — claims, examples, skills, resources, the archives — is reached
// through the guide, the command palette, or footers.
const nav = [
  { label: 'issues', url: '/issues' },
  { label: 'the-signals', url: '/signals' },
  { label: 'the-guide', url: '/guide' },
  { label: 'about', url: '/about' },
];
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (url: string) => {
  const target = withBase(url).replace(/\/$/, '') || '/';
  return here === target || here.startsWith(target + '/');
};
---
<div class="chrome" style={`max-width:${max}`}>
  <header class="chrome-head">
    <a href={withBase('/')} class="chrome-mark">
      <span class="amber">$</span> the-beat<span class="cur" aria-hidden="true">▌</span>
    </a>
    <nav class="chrome-nav" aria-label="Primary">
      {nav.map((n) => (
        <a href={withBase(n.url)} class={isCurrent(n.url) ? 'is-here' : ''} aria-current={isCurrent(n.url) ? 'page' : undefined}>--{n.label}</a>
      ))}
      <button id="open-search" class="chrome-toggle chrome-search" type="button" aria-label="Open command palette (Ctrl or Cmd + K)" title="Commands & search — ⌘K">⌕</button>
      <button id="theme-toggle" class="chrome-toggle" type="button" aria-label="Toggle light or dark theme" aria-pressed="false">◐</button>
    </nav>
  </header>
</div>
