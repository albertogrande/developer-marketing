---
import { withBase } from '../lib/site';
---
<footer class="site-footer">
  <div class="footer-inner">
    {/* One link: the machine entry point, which nothing else in the chrome
        offers. `about`, `source` and `corrections` were dropped from here —
        the masthead is in the primary nav, reachable by `g a` and from the
        command palette, and it carries the repository and correction links
        itself. Dropped earlier for their own reasons — `newsletter` (the
        front page ends in a sign-up form and every issue foot carries one),
        `feed` (in the chrome's ⌘K, the front footer, and <link rel=alternate>
        where readers actually subscribe), and the bare `MIT`, which named the
        wrong licence anyway: content is CC BY 4.0, only the code is MIT. The
        full terms live one click away in about. */}
    <span class="foot-item foot-right">
      <a href={withBase('/llms.txt')}>llms.txt</a>
    </span>
  </div>
</footer>
