---
import { withBase, isoDate, canonicalFor, stripBase, absUrl, CONTENT_LICENSE_URL, VERIFICATION } from '../lib/site';
import { websiteNode, orgNode, articleNode } from '../lib/jsonld';

const SITE_DESC =
  'The state of the art in developer marketing — positioning, docs-led growth, DevRel, developer experience, distribution, and the metrics that matter. Kept current by an autonomous agent.';

interface Props {
  title: string;
  description?: string;
  // 'article' for guide sections, weeklies, deep dives, and radar entries;
  // 'website' otherwise.
  type?: 'website' | 'article';
  published?: Date;
  updated?: Date;
  // Page-specific schema.org nodes (see lib/jsonld.ts). When absent, a
  // sensible default node is derived from the props above.
  jsonLd?: object[];
}
const {
  title,
  description = SITE_DESC,
  type = 'website',
  published,
  updated,
  jsonLd,
} = Astro.props;

const SITE_TITLE = 'The Beat';
const fullTitle =
  title === SITE_TITLE ? 'The Beat — developer marketing, on the record' : `${title} · ${SITE_TITLE}`;
const canonical = canonicalFor(Astro.url.pathname);
const feed = withBase('/feed.xml');
const ogImage = new URL(withBase('/og-default.png'), Astro.site).href;

// Self-hosted JetBrains Mono and Source Serif 4 (variable weight axis, latin
// + latin-ext subsets from public/fonts/) — the site's "no third-party
// request, no tracking" claim has to hold for the font too, and dropping the
// Google Fonts round-trip removes the one render-blocking external request.
// Inline @font-face (not main.scss) so the file URLs go through withBase.
//
// The serif used to be a bare `Charter, ...` stack with no file shipped, so
// the long-form reading face was Charter on macOS, Cambria on Windows and
// Georgia on Linux — a different typeface per reader. Source Serif 4 is
// instanced to opsz=20 (the text design) and clipped to the 400-700 weight
// range the stylesheet asks for, which takes the latin pair from 252K to 67K;
// re-run that step in scripts/ if the axes ever need to widen.
const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT =
  'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';

const face = (family: string, file: string, range: string, style = 'normal') =>
  `@font-face{font-family:'${family}';font-style:${style};font-weight:400 700;font-display:swap;` +
  `src:url(${withBase(`/fonts/${file}.woff2`)}) format('woff2');unicode-range:${range};}`;

const fontCss = [
  face('JetBrains Mono', 'jetbrains-mono-latin', LATIN),
  face('JetBrains Mono', 'jetbrains-mono-latin-ext', LATIN_EXT),
  face('Source Serif 4', 'source-serif-4-latin', LATIN),
  face('Source Serif 4', 'source-serif-4-latin-ext', LATIN_EXT),
  face('Source Serif 4', 'source-serif-4-italic-latin', LATIN, 'italic'),
  face('Source Serif 4', 'source-serif-4-italic-latin-ext', LATIN_EXT, 'italic'),
].join('');

// Machine-readable alternates, derived from the canonical path: every entry
// page has a raw-markdown sibling (/<coll>/<id>.md), every collection index a
// JSON endpoint (/<coll>.json). The agent-surface gate verifies the targets.
const sitePath = stripBase(Astro.url.pathname);
// Keep the first alternation in step with COLLECTIONS (`page: true`) in
// scripts/lib/routes.mjs: check-agent-surface requires every entry page to
// announce its sibling, and that link exists only because this matched.
const mdMatch = sitePath.match(/^\/(guide|articles|issues|threads|deep-dives|radar)\/([^/]+)\/?$/);
const mdPath = mdMatch ? `/${mdMatch[1]}/${mdMatch[2]}.md` : undefined;
const jsonMatch = sitePath.match(
  /^\/(guide|articles|issues|threads|deep-dives|radar|claims|examples|skills|resources|signals|jobs)\/?$/
);
const jsonPath = jsonMatch ? `/${jsonMatch[1]}.json` : undefined;

// One @graph per page: the site-wide WebSite/Organization pair, an automatic
// breadcrumb trail, and either the page-supplied nodes or a default derived
// from the props (Article for reading pages, WebPage otherwise).
const SECTION_LABELS: Record<string, string> = {
  guide: 'Guide',
  articles: 'Newsroom archive',
  issues: 'The Beat',
  threads: 'Threads',
  'deep-dives': 'Deep Dives archive',
  radar: 'Radar archive',
  claims: 'Claims',
  signals: 'Signals',
  jobs: 'Jobs',
  examples: 'Examples',
  skills: 'Skills',
  resources: 'Resources',
  newsletter: 'Newsletter',
  tags: 'Tags',
  about: 'About',
};
const segs = sitePath.replace(/\/$/, '').split('/').filter(Boolean);
const breadcrumb = segs.length
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { name: 'Home', item: absUrl('/') },
        ...(segs.length === 1
          ? [{ name: SECTION_LABELS[segs[0]] ?? title, item: canonical }]
          : [
              { name: SECTION_LABELS[segs[0]] ?? segs[0], item: absUrl(`/${segs[0]}`) },
              { name: title, item: canonical },
            ]),
      ].map((c, i) => ({ '@type': 'ListItem', position: i + 1, ...c })),
    }
  : undefined;

const defaultNode =
  type === 'article'
    ? articleNode({ schemaType: 'Article', title, description, url: canonical, published, updated })
    : {
        '@type': 'WebPage',
        name: fullTitle,
        description,
        url: canonical,
        isPartOf: { '@id': `${absUrl('/')}#website` },
        inLanguage: 'en',
      };

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    websiteNode(SITE_DESC),
    orgNode(),
    ...(breadcrumb ? [breadcrumb] : []),
    ...(jsonLd ?? [defaultNode]),
  ],
};
---
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {/* Media-paired metas are the no-JS fallback; the scripts override both
      with the resolved theme. Colors mirror --bg in main.scss. */}
  <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
  <script is:inline>
    (function () {
      var t = 'light';
      try {
        t =
          localStorage.getItem('sota-theme') ||
          (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light');
      } catch (e) {}
      document.documentElement.setAttribute('data-theme', t);
      var c = t === 'dark' ? '#0d1117' : '#fbfaf8';
      document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
        m.setAttribute('content', c);
        m.removeAttribute('media');
      });
    })();
  </script>

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {/* Answer engines may reuse as much of the page as they need. */}
  <meta name="robots" content="max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  {VERIFICATION.google && <meta name="google-site-verification" content={VERIFICATION.google} />}
  {VERIFICATION.bing && <meta name="msvalidate.01" content={VERIFICATION.bing} />}
  <link rel="canonical" href={canonical} />
  <link rel="license" href={CONTENT_LICENSE_URL} />
  <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE_TITLE} />
  <meta property="og:image" content={ogImage} />
  {published && <meta property="article:published_time" content={isoDate(published)} />}
  {updated && <meta property="article:modified_time" content={isoDate(updated)} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  {/* <-escape so writer-authored titles/summaries containing "</script"
      can't close the element early (broken page / injection). */}
  <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />

  {/* Preload the two latin romans only — the site's furniture and its body
      text. latin-ext and the italic load on demand. */}
  <link rel="preload" href={withBase('/fonts/jetbrains-mono-latin.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={withBase('/fonts/source-serif-4-latin.woff2')} as="font" type="font/woff2" crossorigin />
  <style set:html={fontCss} />
  <link rel="alternate" type="application/atom+xml" title={SITE_TITLE} href={feed} />
  <link rel="alternate" type="application/feed+json" title={SITE_TITLE} href={withBase('/feed.json')} />
  {mdPath && <link rel="alternate" type="text/markdown" title="Markdown" href={withBase(mdPath)} />}
  {jsonPath && <link rel="alternate" type="application/json" title="JSON" href={withBase(jsonPath)} />}
  <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
</head>
