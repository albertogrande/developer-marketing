# The in-house newsletter: copy to newsletter/.env and fill in.
#   set -a; . newsletter/.env; set +a; npm run newsletter:serve
# (.env is gitignored — the secret below must never be committed.)

# --- required ---------------------------------------------------------------
# Signs confirm and unsubscribe tokens and salts stored IP hashes. Generate with
# `openssl rand -hex 32`. Changing it invalidates every outstanding link.
NEWSLETTER_SECRET=

# Where the service is reachable from the internet. Every link in an email is
# minted from this, so it must be the public URL, not the listen address.
PUBLIC_BASE_URL=https://list.example.com

# --- site -------------------------------------------------------------------
# Used for the confirm/unsubscribe redirects and links back into the archive.
SITE_URL=https://albertogrande.github.io/developer-marketing
# Origins allowed to POST the subscribe form. Add http://localhost:4321 while
# developing against `npm run dev`.
ALLOWED_ORIGINS=https://albertogrande.github.io

# --- http -------------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
# Only with a reverse proxy in front: X-Forwarded-For is trusted for rate limits.
TRUST_PROXY=0

# --- storage ----------------------------------------------------------------
# ndjson (a file) or postgres. Leave blank to infer: a DATABASE_URL means
# postgres, which is what Vercel's Neon integration injects.
NEWSLETTER_STORE=

# ndjson: the list lives here as append-only NDJSON. Back this directory up.
DATA_DIR=./newsletter/data

# postgres: required on any host without a durable filesystem (serverless).
# Use the POOLED connection string — a function opening direct connections will
# exhaust the database's slots. Free tiers at Neon and Supabase fit this table
# many times over.
DATABASE_URL=
# Put the table somewhere other than `public` if you share the database.
# PGSCHEMA=newsletter

# --- mail -------------------------------------------------------------------
# The sending domain must be one you control and have authenticated (SPF, DKIM,
# DMARC). A relay will not send as a domain you have not verified.
FROM_EMAIL=the-week@example.com
FROM_NAME=Developer Marketing — The Week
# Replies reach a person. Also used for the mailto: unsubscribe fallback.
REPLY_TO=hello@example.com
LIST_ID=the-week.example.com

# smtp | resend | dry-run. Leave blank to infer: RESEND_API_KEY → resend,
# SMTP_HOST → smtp, neither → dry-run (.eml files in $DATA_DIR/outbox).
MAIL_TRANSPORT=

# --- transport A: any SMTP relay (the default, nothing provider-specific) ----
# Resend:   smtp.resend.com  user "resend"  pass = the API key
# SES:      email-smtp.<region>.amazonaws.com with SMTP credentials
# Postmark: smtp.postmarkapp.com with the server token as user and pass
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
# 1 for implicit TLS (port 465). Otherwise STARTTLS is required and enforced.
SMTP_SECURE=0
SMTP_TLS_REJECT_UNAUTHORIZED=1

# --- transport B: Resend over HTTPS (for serverless, where TCP is awkward) ---
# Setting this alone is enough — the transport is inferred.
RESEND_API_KEY=
# RESEND_BASE_URL=https://api.resend.com

# Force dry-run regardless of the above: messages are written, never sent.
MAIL_DRY_RUN=0

# --- abuse control ----------------------------------------------------------
RATE_PER_IP=5
RATE_WINDOW_MS=900000
RATE_GLOBAL=240
MIN_FILL_MS=1200
CONFIRM_TTL_DAYS=7

# --- sender -----------------------------------------------------------------
# Bearer token for /admin/* — the sender reads the list and reports permanent
# rejections back through it when it runs somewhere other than the service's own
# box (CI, for instance). Empty disables those endpoints entirely.
ADMIN_TOKEN=

# --- bounces ----------------------------------------------------------------
# Signing secret for the relay's webhooks (Resend gives you a whsec_… when you
# add the endpoint https://your-host/webhooks/resend). Empty means every webhook
# is rejected, so bounces and complaints are never honoured and dead addresses
# stay on the list.
WEBHOOK_SECRET=
